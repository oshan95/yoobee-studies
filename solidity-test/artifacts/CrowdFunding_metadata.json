		"devdoc": {
			"details": "Decentralized crowdfunding contract with proposal voting and refund mechanism. Fixes applied:  1. Implemented all empty function bodies (contribute, refund, createRequest, voteRequest, makePayment)  2. Fixed broken createRequest() function signature  3. Added reentrancy guard (ReentrancyGuard) to refund() and makePayment()  4. Added double-vote prevention in voteRequest()  5. Raised minimumContribution from 100 wei to 0.01 ETH  6. Fixed refund() logic — should only work AFTER deadline, not before  7. Added events for all key state changes  8. Added nonReentrant modifier pattern to prevent reentrancy attacks",
			"kind": "dev",
			"methods": {},
			"title": "CrowdFunding",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"contribute()": {
					"notice": "Contribute ETH to the crowdfunding campaign"
				},
				"createRequest(string,address,uint256)": {
					"notice": "Owner creates a spending proposal for contributors to vote on"
				},
				"getBalance()": {
					"notice": "Returns the current ETH balance held by the contract"
				},
				"makePayment(uint256)": {
					"notice": "Execute payment for a proposal if majority voted yes"
				},
				"refund()": {
					"notice": "Refund contributor if target was not met after deadline"
				},
				"voteRequest(uint256)": {
					"notice": "Vote for a spending proposal (one vote per contributor)"
				}
			},
			"version": 1
		}
